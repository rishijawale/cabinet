# Copy to frontend/.env and adjust.
# API base URL; defaults to http://localhost:8000/api/v1 when unset.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Auth — both values must be present to enable accounts. Leave them
# unset (or empty) to run without accounts; saving then stays on the device.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
