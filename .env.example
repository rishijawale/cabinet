# Copy to backend/.env and adjust.
# Cabinet API
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://cabinet:cabinet@127.0.0.1:5432/cabinet
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
PUBLIC_SITE_URL=http://localhost:5173

# Media storage. "local" serves files from MEDIA_ROOT at /media.
STORAGE_BACKEND=local
MEDIA_ROOT=media
MEDIA_BASE_URL=http://localhost:8000/media

# Cloudflare R2 / S3-compatible storage (used when STORAGE_BACKEND=s3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Auth — Supabase. Leave SUPABASE_URL empty to disable auth entirely;
# endpoints then answer 401 AUTH_REQUIRED and the frontend keeps local saves.
# Set it to your project URL (https://xyz.supabase.co) to enable.
SECRET_KEY=change-me
SUPABASE_URL=
# Optional overrides; defaults are derived from SUPABASE_URL.
SUPABASE_JWKS_URL=
SUPABASE_AUDIENCE=authenticated
SUPABASE_ISSUER=
SUPABASE_LEEWAY_SECONDS=30

# Downloads
DOWNLOAD_URL_TTL_SECONDS=300
